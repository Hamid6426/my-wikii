# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
_pycache_/

# Per-language backup made by scripts/backup-lang.sh and scripts/insert-lesson.sh.
# A local cache, regenerated by a new backup, and skipped by every check script.
wiki/langs/*/tmp/

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
